# Normalize line endings: all text files use LF on checkout regardless of OS.
# This prevents CRLF/LF formatter failures (Biome enforces LF) on Windows.
* text=auto eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
